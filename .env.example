# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cfmstats?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# AI Integration (choose one or both)
# OpenAI
OPENAI_API_KEY="sk-..."

# Anthropic Claude
ANTHROPIC_API_KEY="sk-ant-..."

# Email Configuration (optional - for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="CFMStats <noreply@cfmstats.com>"

# Madden Companion App Integration
MADDEN_EXPORT_URL="https://your-export-service.herokuapp.com"
FIREBASE_URL="https://your-firebase.firebaseio.com"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ENABLE_AI_FEATURES="true"
